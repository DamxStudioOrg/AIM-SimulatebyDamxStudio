# Copy to .env and adjust. Never commit .env.
# Ports for compose and start-local.sh.
SIM_PORT=8000
BOARD_PORT=8001
WEB_PORT=3000

# Sim endpoints for the web server, comma-separated, cloud first.
# The first reachable URL wins; localhost keeps local models working.
SIM_API_URL=http://localhost:8000
# Shared token the web server sends as x-sim-token. Leave blank for
# open local play; set the same value on a hosted sim to gate it.
SIM_API_TOKEN=

# Shared secret for sim-signed run receipts: the sim binds every
# score to it and the board rejects anything unsigned or altered.
# Leave blank for local play without receipts; a hosted board sets
# the SAME value in the board's own .env to require verified scores.
SIM_RECEIPT_SECRET=

# Meta API base overrides (tests and stubs only — leave unset or the
# Meta calls break). Llama models use META_API_BASE_URL, Muse models
# (meta/muse-*) use META_MUSE_BASE_URL.
# META_API_BASE_URL=https://api.llama.com/compat/v1
# META_MUSE_BASE_URL=https://api.meta.ai/v1

# Board API base URL for the web server.
LARAVEL_URL=http://localhost:8001

# Comma-separated hosted model ids the sim offers (needs sim .[llm]).
SIM_MODELS=
# Base URL for a local OpenAI-compatible server (LM Studio, llama.cpp).
LOCAL_OPENAI_BASE_URL=http://localhost:1234/v1
# BionicGPT instance base URL including /v1 (your own deployment).
# When set, the sim lists its models as bionic/<id>; each model's
# Bionic API key is saved per model under Connect a bot.
BIONIC_BASE_URL=

# Operator cost rates as JSON ({"model-id": $/1M blended}).
NEXT_PUBLIC_COST_RATES=

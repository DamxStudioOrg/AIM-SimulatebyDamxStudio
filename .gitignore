# Public repo: only the root README.md ships; every other project doc
# (bugfix log, changelog, design notes) stays local.
*.md
!/README.md

# CI stays local until its own pre-publish bar is met: its paths predate
# the app/ move, its actions are tag-pinned, and the web quality gate it
# runs is still red. Revisit, pin to SHAs, then publish.
.github/

# Dependencies (reinstalled per machine)
node_modules/
server/vendor/
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Build output (regenerated by the documented build chain)
web/.next/
app/electron/dist-installer/
app/electron/vendor/
app/sim/dist/
app/sim/build/
*.dmg
*.zip
*.exe
*.AppImage
*.blockmap
# …except the published macOS installer at the repo root (Git LFS).
!/Simulate by Damx Studio-0.1.0-arm64.dmg

# Env, secrets, local data (examples ship; real values never do)
.env
*.sqlite
server/storage/logs/
server/storage/framework/
server/bootstrap/cache/*.php
server/public/downloads/

# OS / editor / test artifacts
.DS_Store
.npm-cache/
.cache/
playwright/.cache/
coverage/
test-results/
playwright-report/
blob-report/
tests/visual/current/
*.tsbuildinfo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log
npm-debug.log*
